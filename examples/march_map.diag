driver = march

march {
  axis = x
  reference = deltau_les
  normalizer = uinf
  start = 200.0
  end = 220.0
  scheme = euler
  rms = true
  linear_average = true
  slices = 205.0,210.0,215.0,220.0
}

modes {
  name = G0
  remove = {
  }

  name = G1
  remove = {
    x_tiltadv_u, x_tiltadv_v, x_tiltadv_w, x_COR, x_SGS,
    x_Reynolds_dubu, x_Reynolds_dubv, x_Reynolds_dubw,
    x_Reynolds_budu, x_Reynolds_budv, x_Reynolds_budw,
    x_baseadv_v, x_baseadv_w,
    x_Reynolds_dudu
  }

  name = G2
  remove = {
    x_tiltadv_u, x_tiltadv_v, x_tiltadv_w, x_COR, x_SGS,
    x_Reynolds_dubu, x_Reynolds_dubv, x_Reynolds_dubw,
    x_Reynolds_budu, x_Reynolds_budv, x_Reynolds_budw,
    x_baseadv_v, x_baseadv_w,
    x_Reynolds_dudu,
    x_nonlinadv_v, x_nonlinadv_w
  }

  name = G3
  remove = {
    x_tiltadv_u, x_tiltadv_v, x_tiltadv_w, x_COR, x_SGS,
    x_Reynolds_dubu, x_Reynolds_dubv, x_Reynolds_dubw,
    x_Reynolds_budu, x_Reynolds_budv, x_Reynolds_budw,
    x_baseadv_v, x_baseadv_w,
    x_Reynolds_dudu,
    x_nonlinadv_v, x_nonlinadv_w,
    x_nonlinadv_u
  }

  name = G4
  remove = {
    x_tiltadv_u, x_tiltadv_v, x_tiltadv_w, x_COR, x_SGS,
    x_Reynolds_dubu, x_Reynolds_dubv, x_Reynolds_dubw,
    x_Reynolds_budu, x_Reynolds_budv, x_Reynolds_budw,
    x_baseadv_v, x_baseadv_w,
    x_Reynolds_dudu,
    x_nonlinadv_v, x_nonlinadv_w,
    x_nonlinadv_u,
    x_deltap
  }
  
}

