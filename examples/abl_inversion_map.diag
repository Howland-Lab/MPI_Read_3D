# ABL inversion method.
# theta is a role, not a generic field list.  It can still be a linear
# combination, for example base potential temperature plus a deficit field.

driver = abl

abl {
  method = inversion
  lengthscale = 1.0
  l0 = 700.0
  d0 = 200.0
  xi = 1.3

  theta {
    (1.0)(Run05_budget0_term26_t000900_n123456.s3D)
  }
}
